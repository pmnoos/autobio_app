<% content_for :title, "The Story of an Ordinary Man with an Extraordinary Life | Peter Magner" %>

<% content_for :description, "Read Peter Magner's autobiography, The Story of an Ordinary Man with an Extraordinary Life — a remarkable journey through family, love, travel, adventure and the memories of a lifetime." %>

<div class="ebook">

  <!-- ========================= -->
  <!-- COVER PAGE -->
  <!-- ========================= -->
  <section style="text-align:center; margin-top:4cm; max-width:60ch; margin-left:auto; margin-right:auto;">

    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold mb-2 bg-gradient-to-r from-yellow-400 via-pink-400 to-purple-400 bg-clip-text text-transparent leading-tight" style="-webkit-text-stroke: 2px white; text-stroke: 2px white;">
      The Story of an Ordinary Man<br>
      <span class="block text-3xl sm:text-5xl lg:text-6xl font-normal mt-2" style="-webkit-text-stroke: 2px white; text-stroke: 2px white;">with an Extraordinary Life</span>
    </h1>

    <p style="margin-top:2rem; font-style:italic;">
      Through the simplicity of my existence, I unearthed the profound truth
      that to love and to be loved is the greatest adventure of all...
    </p>

    <p style="margin-top:1rem;">
      A personal journey through life, love, and adventure.
    </p>
  </section>

  <div class="page-break"></div>

  <!-- ========================= -->
  <!-- CHAPTERS (FLOWING, NO EXTRA PAGES) -->
  <!-- ========================= -->
 <!-- CHAPTERS -->
<div class="chapters">
  <% @chapters.each do |chapter| %>


    <h2 style="margin-top:2rem; text-align:center;">
      <%= chapter.title %>
    </h2>

    <% if @pdf_mode %>
      <% if chapter.image_header&.attached? %>
        <div style="max-width:60ch; margin:1rem auto; text-align:center;">
          <%= wicked_pdf_image_tag(
                Rails.application.routes.url_helpers.rails_blob_path(
                  chapter.image_header,
                  only_path: false
                ),
                alt: chapter.title,
                style: "width:100%; height:auto; display:block;"
              ) %>
        </div>
      <% elsif chapter.image&.attached? %>
        <div style="max-width:60ch; margin:1rem auto; text-align:center;">
          <%= wicked_pdf_image_tag(
                Rails.application.routes.url_helpers.rails_blob_path(
                  chapter.image,
                  only_path: false
                ),
                alt: chapter.title,
                style: "width:100%; height:auto; display:block;"
              ) %>
        </div>
      <% end %>
    <% else %>
      <% if chapter.image_header&.attached? %>
        <div style="max-width:60ch; margin:1rem auto; text-align:center;">
          <%= image_tag url_for(chapter.image_header), alt: chapter.title, style: "width:100%; height:auto; display:block;" %>
        </div>
      <% elsif chapter.image&.attached? %>
        <div style="max-width:60ch; margin:1rem auto; text-align:center;">
          <%= image_tag url_for(chapter.image), alt: chapter.title, style: "width:100%; height:auto; display:block;" %>
        </div>
      <% end %>
    <% end %>

    <div style="line-height:1.8; margin: 0 auto 2rem; text-align: justify; text-justify: inter-word; hyphens: auto; max-width: 60ch;">
      <%= chapter.content %>
    </div>

  <% end %>

</div>
