<div class="bg-white rounded-lg shadow-md p-8">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Send a Message</h2>

  <% if params[:submitted].present? %>
    <p class="mb-6 rounded-md bg-green-50 px-4 py-3 text-green-800" role="status">
      Thank you! Your message has been sent successfully.
    </p>
  <% end %>

  <%= form_with url: "https://formspree.io/f/mzepkqdv", method: :post,
      class: "space-y-6", data: { turbo: false }, authenticity_token: false do |form| %>
    <%= form.hidden_field :_next, value: "#{request.base_url}#{contact_path}?submitted=1" %>
    <div>
      <div style="position: absolute; left: -9999px;" aria-hidden="true">
        <%= form.text_field :_gotcha, tabindex: -1, autocomplete: "off" %>
      </div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :name, required: true,
          class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>

    <div>
      <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.email_field :email, required: true,
          class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>

    <div>
      <%= form.label :_subject, "Subject", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :_subject,
          [
            "General Inquiry",
            "Sharing Memories",
            "Technical Support",
            "Feedback",
            "Other"
          ],
          { prompt: "Choose a topic..." },
          class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>

    <div>
      <%= form.label :message, class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_area :message,
          rows: 6,
          required: true,
          placeholder: "Tell us what's on your mind...",
          class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
    </div>

    <div>
      <%= form.submit "Send Message",
          class: "w-full bg-blue-600 hover:bg-blue-500 text-white font-medium py-3 px-6 rounded-md transition-colors" %>
    </div>
  <% end %>
</div>