<% content_for :title, "Family Tree" %>

<% content_for :head do %>
  <script src="https://unpkg.com/d3@7"></script>
  <link rel="stylesheet" href="https://unpkg.com/family-chart@0.9.0/dist/styles/family-chart.css">
  <script type="module" src="https://unpkg.com/family-chart@0.9.0"></script>

  <style>
    /* Light, easy-to-read colours and larger text for the family tree */
    #FamilyChart {
      --background-color: #faf6ef;
      --text-color: #2b2b2b;
      --male-color: #cfe3ee;
      --female-color: #f4d9dc;
      --genderless-color: #e6e6e6;
      font-size: 18px;
    }
    #FamilyChart path.link {
      stroke: #8a7a68;
      stroke-width: 2px;
    }
    #FamilyChart div.card-main .card-inner {
      outline: 4px solid #b45309;
    }
    #FamilyChart div.card-inner.f3-path-to-main {
      outline: 4px solid #d6a77a;
    }
    #FamilyChart div.card-main .card-inner,
    #FamilyChart div.card:hover .card-inner {
      box-shadow: 0 0 14px 0 rgba(0, 0, 0, 0.25);
    }
  </style>
<% end %>

<div class="max-w-7xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-brand-text mb-2">Family Tree</h1>
  <p class="text-lg text-brand-text mb-3">This is the Magner family tree. Click anyone to see their branch. To protect privacy, details of living family members are kept private. If you spot a mistake or know a story about someone, open their page and send me a note.</p>
  <p class="text-gray-600 mb-6">Click a person to centre the tree on them. Drag to move around and scroll to zoom. Use "View page" on a card to open that person's page.</p>

  <% if @tree_data.empty? %>
    <p class="text-gray-600">No people have been added yet.</p>
  <% else %>
    <div id="FamilyChart" class="f3"
         style="width:100%;height:75vh;min-height:500px;background-color:#faf6ef;color:#2b2b2b;border:1px solid #e5dccd;border-radius:8px;"></div>

    <script type="application/json" id="tree-data"><%= raw json_escape(@tree_data.to_json) %></script>

    <script type="module">
      const data = JSON.parse(document.getElementById("tree-data").textContent);
      const mainId = "<%= @main_id %>";

      const f3Chart = f3.createChart("#FamilyChart", data);

      // Wider spacing to suit the larger cards
      f3Chart.setCardXSpacing(340);
      f3Chart.setCardYSpacing(170);

      f3Chart.setCardHtml()
        .setCardDisplay([["first name", "last name"], ["years"], ["page"]])
        .setCardDim({ w: 300, h: 100, height_auto: true, img_w: 80, img_h: 80, img_x: 0, img_y: 0 });

      if (mainId) f3Chart.updateMainId(mainId);
      f3Chart.updateTree({ initial: true });
    </script>
  <% end %>
</div>
