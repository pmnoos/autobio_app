<% content_for :title, "Showing photo" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <% if notice.present? %>
    <div class="mb-4 text-center">
      <span class="inline-flex items-center px-3 py-1 bg-green-100 text-green-800 text-sm rounded-full border border-green-200" id="notice">
        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <%= notice %>
      </span>
    </div>
  <% end %>

  <!-- Photo Display with Lightbox -->
  <div class="bg-white rounded-2xl shadow-lg p-6 mb-6">
    <div class="text-center mb-4">
      <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @photo.title %></h1>
      <% if @photo.taken_at.present? %>
        <p class="text-purple-600 font-medium">
          <%= @photo.taken_at.strftime("%B %d, %Y") %>
        </p>
      <% end %>
    </div>
    
        <!-- Clickable Photo -->
        <div class="cursor-pointer rounded-lg overflow-hidden" onclick="window.openPhotoLightbox()" id="photo-container">
          <%= image_tag @photo.image, 
              alt: @photo.title,
              class: "w-full h-auto max-h-96 object-contain mx-auto hover:opacity-90 transition-opacity duration-200" %>
        </div>
    
    <% if @photo.description.present? %>
      <div class="mt-4 text-center">
        <p class="text-gray-600 leading-relaxed"><%= @photo.description %></p>
      </div>
    <% end %>
  </div>

  <!-- Action Buttons -->
  <div class="flex flex-col sm:flex-row gap-3 items-center justify-center">
    <!-- Simple Back to Reading button - always visible -->
    <%= link_to chapters_path,
        class: "inline-flex items-center px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg font-medium transition duration-150 ease-in-out" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
      </svg>
      Back to Reading
    <% end %>
    
    <!-- Always visible close button to continue reading -->
    <%= link_to chapters_path, 
        class: "inline-flex items-center px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition duration-150 ease-in-out" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
      Close Photo
    <% end %>
    
    <%= link_to photos_path, 
        class: "inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition duration-150 ease-in-out" do %>
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      Back to Gallery
    <% end %>
    
    <% if authenticated? %>
      <%= link_to edit_photo_path(@photo), 
          class: "inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition duration-150 ease-in-out" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
        </svg>
        Edit
      <% end %>
    <% end %>
  </div>
</div>

<!-- Lightbox Modal -->
<div id="lightbox" class="fixed inset-0 bg-black bg-opacity-90 z-50" style="display: none;">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="relative max-w-7xl max-h-full">
      <!-- Close Button -->
      <button onclick="window.closePhotoLightbox()" class="absolute top-6 right-6 text-white hover:text-red-300 z-50 bg-red-600 bg-opacity-90 rounded-full p-3 hover:bg-opacity-100 transition-all shadow-lg border-2 border-white">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      
      <!-- Image -->
      <img id="lightbox-image" src="" alt="" class="max-w-full max-h-full object-contain">
      
      <!-- Photo Info -->
      <div id="lightbox-info" class="absolute bottom-4 left-4 right-4 text-white bg-black bg-opacity-50 rounded-lg p-4">
        <h3 id="lightbox-title" class="text-xl font-semibold mb-2"></h3>
        <p id="lightbox-date" class="text-sm text-gray-300 mb-2"></p>
        <p id="lightbox-description" class="text-sm mb-4"></p>
        
        <!-- Action buttons in lightbox -->
        <% if authenticated? %>
          <div class="flex space-x-3 justify-center">
            <%= link_to edit_photo_path(@photo), 
                class: "inline-flex items-center px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition duration-150 ease-in-out text-sm" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
              Edit
            <% end %>
            <%= link_to @photo, method: :delete, 
                confirm: "Are you sure you want to delete this photo?",
                class: "inline-flex items-center px-3 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium transition duration-150 ease-in-out text-sm" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
              Delete
            <% end %>
            <%= link_to photos_path, 
                class: "inline-flex items-center px-3 py-2 bg-gray-600 hover:bg-gray-700 text-white rounded-lg font-medium transition duration-150 ease-in-out text-sm" do %>
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              Gallery
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

    <script>
      // Prevent redeclaration issues with Turbo
      if (typeof window.photoPageLoaded === 'undefined') {
        window.photoPageLoaded = true;
        
        window.currentPhotoData = {
          title: "<%= j @photo.title %>",
          description: "<%= j @photo.description %>",
          taken_at: "<%= @photo.taken_at&.strftime("%B %d, %Y") %>",
          image_url: "<%= url_for(@photo.image) %>"
        };
        
        window.openPhotoLightbox = function() {
          document.getElementById('lightbox-image').src = window.currentPhotoData.image_url;
          document.getElementById('lightbox-title').textContent = window.currentPhotoData.title;
          document.getElementById('lightbox-date').textContent = window.currentPhotoData.taken_at || '';
          document.getElementById('lightbox-description').textContent = window.currentPhotoData.description || '';
          
          const lightbox = document.getElementById('lightbox');
          lightbox.style.display = 'block';
          document.body.style.overflow = 'hidden';
        };
        
        window.closePhotoLightbox = function() {
          const lightbox = document.getElementById('lightbox');
          lightbox.style.display = 'none';
          document.body.style.overflow = 'auto';
        };
        
        // Check if user came from a chapter page and show appropriate back button
        document.addEventListener('DOMContentLoaded', function() {
          const referrer = document.referrer;
          const urlParams = new URLSearchParams(window.location.search);
          const hashParams = new URLSearchParams(window.location.hash.slice(1));
          const fromChapter = urlParams.get('from') === 'chapter';
          const chapterPath = urlParams.get('chapter_path');
          const chapterId = urlParams.get('chapter_id') || hashParams.get('chapter_id');
          const backToChapterBtn = document.getElementById('back-to-chapter-btn');
          const photoContainer = document.getElementById('photo-container');
          
          // Force show the debugging info
          console.log('=== PHOTO PAGE DEBUG ===');
          console.log('Referrer:', referrer);
          console.log('URL params:', urlParams.toString());
          console.log('Hash params:', hashParams.toString());
          console.log('From chapter param:', fromChapter);
          console.log('Chapter path:', chapterPath);
          console.log('Chapter ID:', chapterId);
          console.log('Back button element found:', !!backToChapterBtn);
          
          // Enhanced referrer detection - check if the referrer is a chapter page
          const isFromChapter = referrer && (
            referrer.includes('/chapters/') && 
            !referrer.includes('/edit') && 
            !referrer.includes('/new') &&
            !referrer.includes('/list')
          );
          
          console.log('Is from chapter (calculated):', isFromChapter);
          
          // Show back button if ANY of these conditions are true
          if (isFromChapter || fromChapter || chapterId) {
            console.log('✅ SHOWING Back to Chapter button');
            
            // Show the "Back to Chapter" button
            if (backToChapterBtn) {
              backToChapterBtn.classList.remove('hidden');
              backToChapterBtn.style.display = 'inline-flex'; // Force show
            }
            
            // Set the href - prioritize chapter_id, then chapter_path, then referrer, then chapters list
            if (chapterId) {
              backToChapterBtn.href = `/chapters/${chapterId}`;
              console.log('Using chapter_id path:', `/chapters/${chapterId}`);
            } else if (chapterPath) {
              backToChapterBtn.href = decodeURIComponent(chapterPath);
              console.log('Using chapter_path:', decodeURIComponent(chapterPath));
            } else if (isFromChapter) {
              backToChapterBtn.href = referrer;
              console.log('Using referrer path:', referrer);
            } else {
              backToChapterBtn.href = '/chapters';
              console.log('Using default chapters path');
            }
            }
            
            // Hide the "Close Photo" and "Back to Gallery" buttons since they came from a chapter
            const closePhotoBtn = document.querySelector('a[href="/chapters"]');
            const backToGalleryBtn = document.querySelector('a[href="/photos"]');
            
            if (closePhotoBtn) closePhotoBtn.style.display = 'none';
            if (backToGalleryBtn) backToGalleryBtn.style.display = 'none';
            
            // Disable the lightbox click functionality when coming from chapter
            if (photoContainer) {
              photoContainer.onclick = null;
              photoContainer.style.cursor = 'default';
              photoContainer.title = 'Use the "Back to Chapter" button below to continue reading';
            }
          } else {
            console.log('❌ NO chapter detection - showing back button anyway for testing');
            // TEMPORARY: Always show back button for testing
            if (backToChapterBtn) {
              backToChapterBtn.classList.remove('hidden');
              backToChapterBtn.style.display = 'inline-flex';
              backToChapterBtn.href = '/chapters';
              backToChapterBtn.innerHTML = backToChapterBtn.innerHTML.replace('Back to Chapter', 'Back to Chapters (Test)');
            }
          }
        });
        
        // Keyboard navigation
        document.addEventListener('keydown', function(e) {
          const lightbox = document.getElementById('lightbox');
          if (lightbox.style.display === 'block') {
            if (e.key === 'Escape') window.closePhotoLightbox();
          }
        });
        
        // Close lightbox when clicking outside image
        document.getElementById('lightbox').addEventListener('click', function(e) {
          if (e.target === this) window.closePhotoLightbox();
        });
      }
    </script>
