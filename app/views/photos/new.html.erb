<% content_for :title, "New photo" %>

<div class="max-w-4xl mx-auto px-4 py-8">
  <!-- Header Section -->
  <div class="bg-white shadow-lg rounded-lg p-6 mb-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h1 class="font-bold text-3xl text-gray-800">Add New Photo</h1>
        <p class="text-gray-600 mt-2">Upload a photo to your autobiography gallery</p>
      </div>
      <div class="flex space-x-3">
        <%= link_to photos_path, class: "inline-flex items-center px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition duration-150 ease-in-out" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          Back to Photos
        <% end %>
      </div>
    </div>
    
    <!-- Photo Tips -->
    <div class="bg-green-50 border border-green-200 rounded-lg p-4">
      <div class="flex">
        <div class="flex-shrink-0">
          <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-green-800">Photo Tips</h3>
          <div class="mt-2 text-sm text-green-700">
            <ul class="list-disc pl-5 space-y-1">
              <li>Choose high-quality images that tell part of your story</li>
              <li>Add descriptive titles and detailed descriptions</li>
              <li>Include the date when the photo was taken if you remember it</li>
              <li>Photos will be displayed in your gallery and can be linked from chapters</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Form Section -->
  <div class="bg-white shadow-lg rounded-lg p-6">
    <%= render "form", photo: @photo %>
  </div>
</div>
