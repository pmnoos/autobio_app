<% content_for :title, "My Autobiography - Home" %>

<!-- Hero Section -->
<section class="relative bg-linear-to-br from-purple-900 via-blue-800 to-teal-700 text-white overflow-hidden">
  <div class="absolute inset-0 bg-black bg-opacity-30"></div>
  <!-- Decorative elements -->
  <div class="absolute bottom-10 right-10 w-32 h-32 bg-yellow-400 bg-opacity-15 rounded-full blur-2xl"></div>
  <div class="absolute top-1/3 right-1/4 w-16 h-16 bg-pink-400 bg-opacity-10 rounded-full blur-lg"></div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 sm:py-32">
    <div class="text-center">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-bold mb-6 bg-linear-to-r from-yellow-400 via-pink-400 to-purple-400 bg-clip-text text-transparent leading-tight" style="-webkit-text-stroke: 2px white; text-stroke: 2px white;">
        The Story of an Ordinary Man<br>
        <span class="text-3xl sm:text-5xl lg:text-6xl" style="-webkit-text-stroke: 2px white; text-stroke: 2px white;">with an Extraordinary Life</span>
      </h1>
      <p class="text-xl sm:text-2xl mb-8 text-blue-100 max-w-4xl mx-auto leading-relaxed">
        Through the simplicity of my existence, I unearthed the profound truth that to love and to be loved is the greatest adventure of all...<br>
        <span class="text-lg sm:text-xl text-teal-200 mt-2 block">A personal journey through life, love, and adventure.</span>
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center max-w-4xl mx-auto">
        <%= link_to list_chapters_path, 
            class: "group bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white px-8 py-4 rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-xl hover:shadow-2xl flex items-center" do %>
          <svg class="w-5 h-5 mr-2 group-hover:animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          Start Reading
        <% end %>
        
        <% if authenticated? %>
        <%= link_to export_pdf_chapters_path(format: :pdf), 
            class: "group bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white px-8 py-4 rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-xl hover:shadow-2xl flex items-center",
            target: "_blank" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Download PDF
        <% end %>
        <% end %>
        <% if authenticated? %>
        <%= link_to export_pdf_chapters_path(format: :docx), 
            class: "group border-2 border-blue-300 text-blue-300 hover:bg-blue-300 hover:text-gray-900 px-8 py-4 rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-lg flex items-center",
            target: "_blank" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          Download DOCX
        <% end %>
        <% end %>
        
        <%= link_to photos_path, 
            class: "group border-2 border-teal-300 text-teal-300 hover:bg-teal-300 hover:text-gray-900 px-8 py-4 rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-lg flex items-center" do %>
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          View Gallery
        <% end %>
      </div>

      <div class="mt-8 max-w-3xl mx-auto bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-5">
        <h2 class="text-xl sm:text-2xl font-semibold text-white mb-3">Listen to the Full Biography</h2>
        <details>
          <summary class="cursor-pointer inline-flex items-center px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium">Open Audio</summary>
          <div class="mt-4">
            <audio controls preload="none" class="w-full mb-4">
              <source src="<%= full_bio_audio_stream_url %>" type="audio/mpeg">
              Your browser does not support the audio element.
            </audio>
            <div class="flex flex-wrap gap-3 justify-center">
              <a href="<%= full_bio_audio_download_url %>" class="inline-flex items-center px-4 py-2 rounded-lg bg-white/20 hover:bg-white/30 text-white font-medium">
                Download MP3
              </a>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="py-20 bg-linear-to-br from-orange-50 via-pink-50 to-purple-50 relative overflow-hidden">
  <!-- Background decorations -->
  <div class="absolute top-0 left-0 w-full h-full">
    <div class="absolute top-20 left-20 w-32 h-32 bg-purple-200 bg-opacity-30 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-20 w-40 h-40 bg-pink-200 bg-opacity-30 rounded-full blur-3xl"></div>
  </div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-20">
      <h2 class="text-4xl sm:text-5xl font-bold bg-linear-to-r from-purple-600 via-blue-600 to-teal-600 bg-clip-text text-transparent mb-6">
        Explore My Story
      </h2>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto leading-relaxed">
        Discover the different ways you can experience my autobiography and journey through the chapters of my life
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      <!-- Chapters Feature -->
      <div class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-3 border border-gray-100 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-linear-to-br from-purple-100 to-blue-100 rounded-full -translate-y-10 translate-x-10"></div>
        <div class="relative">
          <div class="bg-linear-to-br from-purple-500 to-blue-500 rounded-2xl w-16 h-16 mx-auto mb-6 flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">Life Chapters</h3>
          <p class="text-gray-600 mb-6 leading-relaxed text-center">
            Read through the different chapters of my life story, each with rich text content 
            and accompanying images that bring the memories to life.
          </p>
          <%= link_to list_chapters_path, 
              class: "block w-full text-center bg-linear-to-r from-purple-600 to-blue-600 text-white px-6 py-3 rounded-xl font-semibold hover:from-purple-700 hover:to-blue-700 transition-all transform hover:scale-105 shadow-lg" do %>
            Read Chapters
          <% end %>
        </div>
      </div>

      <!-- Gallery Feature -->
      <div class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-3 border border-gray-100 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-20 h-20 bg-linear-to-br from-green-100 to-teal-100 rounded-full -translate-y-10 translate-x-10"></div>
        <div class="relative">
          <div class="bg-linear-to-br from-green-500 to-teal-500 rounded-2xl w-16 h-16 mx-auto mb-6 flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">Photo Gallery</h3>
          <p class="text-gray-600 mb-6 leading-relaxed text-center">
            Browse through a curated collection of photographs that capture important 
            moments, people, and places throughout my journey.
          </p>
          <%= link_to photos_path, 
              class: "block w-full text-center bg-linear-to-r from-green-600 to-teal-600 text-white px-6 py-3 rounded-xl font-semibold hover:from-green-700 hover:to-teal-700 transition-all transform hover:scale-105 shadow-lg" do %>
            View Gallery
          <% end %>
        </div>
      </div>

      <!-- PDF Export Feature -->
      <div class="group bg-white rounded-3xl p-8 shadow-xl hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-3 border border-gray-100 relative overflow-hidden md:col-span-2 lg:col-span-1">
        <div class="absolute top-0 right-0 w-20 h-20 bg-linear-to-br from-red-100 to-pink-100 rounded-full -translate-y-10 translate-x-10"></div>
        <div class="relative">
          <div class="bg-linear-to-br from-red-500 to-pink-500 rounded-2xl w-16 h-16 mx-auto mb-6 flex items-center justify-center group-hover:scale-110 group-hover:rotate-6 transition-all duration-300 shadow-lg">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-gray-900 mb-4 text-center">Download PDF</h3>
          <p class="text-gray-600 mb-6 leading-relaxed text-center">
            Get the complete autobiography as a beautifully formatted PDF document 
            that you can read offline or share with others.
          </p>
          <% if authenticated? %>
            <%= link_to export_pdf_chapters_path(format: :pdf), 
                class: "block w-full text-center bg-linear-to-r from-red-600 to-pink-600 text-white px-6 py-3 rounded-xl font-semibold hover:from-red-700 hover:to-pink-700 transition-all transform hover:scale-105 shadow-lg",
                target: "_blank" do %>
              Download PDF
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Recent Chapters Section -->
<% if @chapters.any? %>
<section class="py-20 bg-linear-to-br from-indigo-50 via-white to-cyan-50 relative overflow-hidden">
  <!-- Background decorations -->
  <div class="absolute top-0 left-0 w-full h-full">
    <div class="absolute top-10 right-10 w-40 h-40 bg-indigo-200 bg-opacity-20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 left-10 w-32 h-32 bg-cyan-200 bg-opacity-20 rounded-full blur-3xl"></div>
  </div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl sm:text-5xl font-bold bg-linear-to-r from-indigo-600 via-purple-600 to-pink-600 bg-clip-text text-transparent mb-6">
        Recent Chapters
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        The latest additions to my story - dive into these recent chapters to discover new adventures and insights
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      <% @chapters.limit(3).each do |chapter| %>
        <div class="group bg-white rounded-3xl shadow-xl overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-3 border border-gray-100 relative">
          <!-- Chapter Image/Header -->
          <% if chapter.image_header.attached? %>
            <div class="h-56 overflow-hidden relative">
              <%= image_tag url_for(chapter.image_header), 
                  alt: chapter.title,
                  class: "w-full h-full object-cover group-hover:scale-110 transition-transform duration-500",
                  loading: "lazy" %>
              <div class="absolute inset-0 bg-linear-to-t from-black/50 to-transparent"></div>
              <div class="absolute top-4 right-4">
                <span class="bg-white/90 backdrop-blur-sm text-gray-800 px-3 py-1 rounded-full text-sm font-semibold">
                  <% if chapter.dedication_chapter? %>
                    Dedication
                  <% elsif chapter.intro_chapter? %>
                    Introduction
                  <% elsif chapter.epilogue_chapter? %>
                    Epilogue
                  <% elsif chapter.afterword_chapter? %>
                    Afterword
                  <% elsif chapter.about_author_chapter? %>
                    About the Author
                  <% else %>
                    Chapter <%= chapter.chapter_number %>
                  <% end %>
                </span>
              </div>
            </div>
          <% else %>
            <div class="h-56 bg-linear-to-br from-purple-400 via-pink-400 to-orange-400 flex items-center justify-center relative overflow-hidden">
              <div class="absolute inset-0 bg-linear-to-br from-black/20 to-transparent"></div>
              <div class="relative text-center">
                <div class="w-16 h-16 bg-white/20 backdrop-blur-sm rounded-full flex items-center justify-center mx-auto mb-3">
                  <% if chapter.dedication_chapter? %>
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 19.364l-7.682-7.682a4.5 4.5 0 010-6.364z" />
                    </svg>
                  <% elsif chapter.intro_chapter? %>
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  <% elsif chapter.epilogue_chapter? %>
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H3"></path>
                    </svg>
                  <% elsif chapter.afterword_chapter? %>
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                  <% elsif chapter.about_author_chapter? %>
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A9 9 0 1118.88 17.8M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  <% else %>
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                  <% end %>
                </div>
                <span class="text-white text-lg font-bold block">
                  <% if chapter.dedication_chapter? %>
                    Dedication
                  <% elsif chapter.intro_chapter? %>
                    Introduction
                  <% elsif chapter.epilogue_chapter? %>
                    Epilogue
                  <% elsif chapter.afterword_chapter? %>
                    Afterword
                  <% elsif chapter.about_author_chapter? %>
                    About the Author
                  <% else %>
                    Chapter <%= chapter.chapter_number %>
                  <% end %>
                </span>
              </div>
            </div>
          <% end %>
          
          <!-- Chapter Content -->
          <div class="p-6">
            <div class="mb-3">
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-purple-600 transition-colors leading-tight">
                <%= link_to chapter.title, chapter, class: "hover:underline" %>
              </h3>
            </div>
            
            <% if chapter.subtitle.present? %>
              <p class="text-gray-600 mb-3 font-medium text-sm"><%= chapter.subtitle %></p>
            <% end %>
            
            <p class="text-gray-700 mb-4 leading-relaxed text-sm">
              <%= truncate(strip_tags(chapter.content.to_s), length: 100) %>
            </p>
            
            <div class="flex items-center justify-between">
              <%= link_to chapter, 
                  class: "inline-flex items-center bg-linear-to-r from-purple-600 to-pink-600 text-white px-4 py-2 rounded-xl font-medium hover:from-purple-700 hover:to-pink-700 transition-all transform hover:scale-105 text-sm shadow-lg" do %>
                Read More
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              <% end %>
              
              <div class="flex space-x-2">
                <% if authenticated? %>
                  <%= link_to export_chapter_pdf_chapter_path(chapter, format: :pdf), 
                      class: "text-gray-400 hover:text-red-500 transition-colors",
                      target: "_blank",
                      title: "Download as PDF" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    
    <div class="text-center mt-16">
      <%= link_to list_chapters_path, 
          class: "group inline-flex items-center bg-linear-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white px-10 py-4 rounded-xl font-semibold text-lg transition-all transform hover:scale-105 shadow-xl hover:shadow-2xl" do %>
        View All Chapters
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      <% end %>
    </div>
  </div>
</section>
<% end %>
