<% content_for :title, "All Chapters" %>

<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="bg-amber-50 border border-amber-200 text-amber-900 rounded-lg p-4 mb-6">
    <p class="font-semibold">Chapter list is running in safe mode.</p>
    <p class="text-sm mt-1">A formatting issue was detected on the full list page. You can still open every chapter below.</p>
  </div>

  <div class="space-y-3">
    <% @chapters.each do |chapter| %>
      <div class="bg-white border border-gray-200 rounded-lg px-4 py-3 flex items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="font-medium text-gray-900 truncate"><%= chapter.title.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: "") %></p>
          <% if chapter.subtitle.present? %>
            <p class="text-sm text-gray-600 truncate"><%= chapter.subtitle.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: "") %></p>
          <% end %>
        </div>
        <%= link_to "Open", chapter_path(chapter), class: "shrink-0 bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-md text-sm font-medium" %>
      </div>
    <% end %>
  </div>
</div>
