<% content_for :title, "All Chapters" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">All Chapters</h1>
    <p class="text-gray-600 mt-2">Browse through all the chapters of my life story</p>
  </div>

  <div class="space-y-8">
    <% @chapters.each do |chapter| %>
      <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
        <div class="flex flex-col lg:flex-row">
          <div class="lg:w-1/3">
            <% if chapter.image_header.attached? %>
              <%= image_tag url_for(chapter.image_header), class: "w-full h-48 object-cover rounded-lg", alt: chapter.title %>
            <% elsif chapter.respond_to?(:image) && chapter.image.attached? %>
              <%= image_tag url_for(chapter.image), class: "w-full h-48 object-cover rounded-lg", alt: chapter.title %>
            <% else %>
              <div class="w-full h-48 bg-linear-to-br from-gray-100 to-gray-200 flex items-center justify-center rounded-lg">
                <span class="text-gray-500 text-lg font-medium">Chapter</span>
              </div>
            <% end %>
          </div>

          <div class="lg:w-2/3 p-8">
            <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-3">
              <%= link_to chapter.title.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: ""), chapter, class: "hover:text-blue-600 transition-colors" %>
            </h2>

            <% if chapter.subtitle.present? %>
              <p class="text-xl text-gray-600 mb-4 leading-relaxed"><%= chapter.subtitle.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: "") %></p>
            <% end %>

            <div class="text-gray-700 mb-6 leading-relaxed">
              <%= truncate(strip_tags(chapter.content.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: "")), length: 300) %>
            </div>

            <div class="flex flex-wrap gap-3">
              <%= link_to "Read Chapter", chapter_path(chapter), class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg font-medium text-sm transition-colors" %>

              <% if chapter.audio_file.attached? %>
                <%= link_to "Listen", chapter_path(chapter, anchor: "chapter-audio"), class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg font-medium text-sm transition-colors" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5 6 9H3v6h3l5 4V5Zm4.5 4.5a4.5 4.5 0 0 1 0 5m2.5-7.5a8 8 0 0 1 0 10" />
                  </svg>
                  Listen
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
