<% content_for :title, "Showing chapter" %>

<div class="max-w-5xl mx-auto px-4 py-8">
  <% if notice.present? %>
    <div class="mb-4 text-center">
      <span class="inline-flex items-center px-3 py-1 bg-green-100 text-green-800 text-sm rounded-full border border-green-200" id="notice">
        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
        <%= notice %>
      </span>
    </div>
  <% end %>

  <!-- Chapter Content -->
  <div class="mb-8">
    <%= render @chapter %>
  </div>

  <!-- Chapter Navigation -->
  <div class="bg-gradient-to-r from-purple-50 to-blue-50 rounded-lg p-6 mb-8">
    <div class="flex items-center justify-between">
      <!-- Previous Chapter -->
      <div class="flex-1">
        <% if @previous_chapter %>
          <%= link_to chapter_path(@previous_chapter), 
              class: "group flex items-center space-x-3 text-left hover:bg-white rounded-lg p-3 transition-all duration-200 hover:shadow-md" do %>
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-purple-600 group-hover:bg-purple-700 rounded-full flex items-center justify-center transition-colors">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                </svg>
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-sm text-purple-600 font-medium">Previous</p>
              <p class="text-gray-900 font-semibold">
                <% if @previous_chapter.dedication_chapter? %>
                  Dedication
                <% elsif @previous_chapter.intro_chapter? %>
                  Introduction
                <% elsif @previous_chapter.epilogue_chapter? %>
                  Epilogue
                <% else %>
                  Chapter <%= @previous_chapter.chapter_number %>
                <% end %>
              </p>
            </div>
          <% end %>
        <% else %>
          <div class="opacity-50">
            <div class="flex items-center space-x-3 p-3">
              <div class="flex-shrink-0">
                <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                  </svg>
                </div>
              </div>
              <div>
                <p class="text-sm text-gray-400 font-medium">Previous</p>
                <p class="text-gray-400">First chapter</p>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <!-- Current Chapter Indicator -->
      <div class="flex-shrink-0 mx-8 text-center">
        <div class="bg-white rounded-lg px-6 py-4 shadow-sm border border-purple-100">
          <p class="text-xs text-purple-600 font-medium uppercase tracking-wide">Currently Reading</p>
          <p class="text-lg font-bold text-gray-900 mt-1">
            <% if @chapter.dedication_chapter? %>
              Dedication
            <% elsif @chapter.intro_chapter? %>
              Introduction
            <% elsif @chapter.epilogue_chapter? %>
              Epilogue
            <% else %>
              Chapter <%= @chapter.chapter_number %>
            <% end %>
          </p>
        </div>
      </div>

      <!-- Next Chapter -->
      <div class="flex-1">
        <% if @next_chapter %>
          <%= link_to chapter_path(@next_chapter), 
              class: "group flex items-center space-x-3 text-right hover:bg-white rounded-lg p-3 transition-all duration-200 hover:shadow-md justify-end" do %>
            <div class="min-w-0 flex-1">
              <p class="text-sm text-blue-600 font-medium">Next</p>
              <p class="text-gray-900 font-semibold">
                <% if @next_chapter.dedication_chapter? %>
                  Dedication
                <% elsif @next_chapter.intro_chapter? %>
                  Introduction
                <% elsif @next_chapter.epilogue_chapter? %>
                  Epilogue
                <% else %>
                  Chapter <%= @next_chapter.chapter_number %>
                <% end %>
              </p>
            </div>
            <div class="flex-shrink-0">
              <div class="w-10 h-10 bg-blue-600 group-hover:bg-blue-700 rounded-full flex items-center justify-center transition-colors">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </div>
            </div>
          <% end %>
        <% else %>
          <div class="opacity-50">
            <div class="flex items-center space-x-3 p-3 justify-end">
              <div>
                <p class="text-sm text-gray-400 font-medium text-right">Next</p>
                <p class="text-gray-400 text-right">Last chapter</p>
              </div>
              <div class="flex-shrink-0">
                <div class="w-10 h-10 bg-gray-300 rounded-full flex items-center justify-center">
                  <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Action Buttons -->
  <div class="bg-white shadow-lg rounded-lg p-6">
    <div class="flex flex-col sm:flex-row gap-4 items-center justify-center">
      <% if authenticated? %>
        <%= link_to edit_chapter_path(@chapter), 
            class: "inline-flex items-center px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded text-sm transition duration-150 ease-in-out" do %>
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
          Edit
        <% end %>
      <% end %>
      
      <% if authenticated? %>
        <%= link_to export_chapter_pdf_chapter_path(@chapter, format: :pdf), 
            class: "inline-flex items-center px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded text-sm transition duration-150 ease-in-out",
            target: "_blank" do %>
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          PDF
        <% end %>
      <% end %>
      
      <%= link_to chapters_path, 
          class: "inline-flex items-center px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded text-sm transition duration-150 ease-in-out" do %>
        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back
      <% end %>
      
      <% if authenticated? %>
        <%= link_to chapter_path(@chapter), method: :delete, 
            class: "inline-flex items-center px-3 py-1.5 bg-red-100 hover:bg-red-200 text-red-700 rounded text-sm transition duration-150 ease-in-out",
            data: { "turbo-method": "delete", "turbo-confirm": "Are you sure you want to delete this chapter?" } do %>
          <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
          </svg>
          Delete
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<!-- Lightbox Modal for Chapter Photos -->
<div id="chapter-lightbox" class="fixed inset-0 bg-black bg-opacity-90 z-50" style="display: none;">
  <!-- Multiple prominent close buttons -->
  <!-- Top-right corner close button -->
  <button onclick="closeChapterLightbox()" class="fixed top-4 right-4 text-white hover:text-gray-200 z-50 bg-red-600 hover:bg-red-700 rounded-full p-3 transition-all shadow-2xl border-2 border-white" style="z-index: 999;">
    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>
  
  <!-- Top-left corner close button with text -->
  <button onclick="closeChapterLightbox()" class="fixed top-4 left-4 text-white hover:text-gray-200 z-50 bg-blue-600 hover:bg-blue-700 rounded-lg px-4 py-2 transition-all shadow-2xl border-2 border-white" style="z-index: 999;">
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
      </svg>
      <span class="text-sm font-medium">Continue Reading</span>
    </div>
  </button>
  
  <!-- Bottom center close button -->
  <button onclick="closeChapterLightbox()" class="fixed bottom-4 left-1/2 transform -translate-x-1/2 text-white hover:text-gray-200 z-50 bg-green-600 hover:bg-green-700 rounded-lg px-6 py-3 transition-all shadow-2xl border-2 border-white" style="z-index: 999;">
    <div class="flex items-center">
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
      <span class="font-medium">Close Photo</span>
    </div>
  </button>

  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="relative max-w-7xl max-h-full">      
      <!-- Image -->
      <div class="relative">
        <img id="chapter-lightbox-image" src="" alt="" class="max-w-full max-h-full object-contain">
      </div>
      
      <!-- Photo Info -->
      <div id="chapter-lightbox-info" class="absolute bottom-4 left-4 right-4 text-white bg-black bg-opacity-50 rounded-lg p-4">
        <h3 id="chapter-lightbox-title" class="text-xl font-semibold mb-2"></h3>
        <p id="chapter-lightbox-date" class="text-sm text-gray-300 mb-2"></p>
        <p id="chapter-lightbox-description" class="text-sm"></p>
      </div>
    </div>
  </div>
</div>

<script>
  // Chapter Lightbox functionality
  function openChapterLightbox(imageUrl, title, description, takenAt) {
    document.getElementById('chapter-lightbox-image').src = imageUrl;
    document.getElementById('chapter-lightbox-title').textContent = title || 'Photo';
    document.getElementById('chapter-lightbox-date').textContent = takenAt || '';
    document.getElementById('chapter-lightbox-description').textContent = description || '';
    
    const lightbox = document.getElementById('chapter-lightbox');
    lightbox.style.display = 'block';
    document.body.style.overflow = 'hidden';
  }
  
  function closeChapterLightbox() {
    const lightbox = document.getElementById('chapter-lightbox');
    if (lightbox) {
      lightbox.style.display = 'none';
      document.body.style.overflow = 'auto';
    }
  }
  
  // Make chapter image links open in lightbox
  document.addEventListener('DOMContentLoaded', function() {
    // Find all image links in the chapter content (both gallery photos and direct images)
    const imageLinks = document.querySelectorAll('a[href*="/images/chapters/"], a[href*="/photos/"]');
    
    imageLinks.forEach(link => {
      link.addEventListener('click', function(e) {
        // Check if user wants to open in new tab (Ctrl+click or Cmd+click)
        if (e.ctrlKey || e.metaKey) {
          return true; // Allow default behavior (open in new tab)
        }
        
        e.preventDefault();
        e.stopPropagation();
        
        const href = this.href;
        
        // Handle direct image links (from /images/chapters/)
        if (href.includes('/images/chapters/')) {
          const imageName = href.split('/').pop();
          const title = this.textContent || this.getAttribute('title') || imageName;
          
          openChapterLightbox(href, title, '', '');
          return;
        }
        
        // Handle gallery photos (existing functionality)
        const photoIdMatch = href.match(/\/photos\/(\d+)/);
        if (photoIdMatch) {
          fetch(`/photos/${photoIdMatch[1]}.json`)
            .then(response => {
              if (!response.ok) {
                throw new Error('Photo not found');
              }
              return response.json();
            })
            .then(photoData => {
              if (photoData.image_url) {
                openChapterLightbox(
                  photoData.image_url,
                  photoData.title || 'Photo',
                  photoData.description || '',
                  photoData.taken_at || ''
                );
              }
            })
            .catch(error => {
              console.error('Error loading photo:', error);
              // Fallback: open in new tab
              window.open(href, '_blank');
            });
        }
      });
    });
  });
  
  // Keyboard navigation for chapter lightbox
  document.addEventListener('keydown', function(e) {
    const lightbox = document.getElementById('chapter-lightbox');
    if (lightbox.style.display === 'block') {
      if (e.key === 'Escape') closeChapterLightbox();
    }
  });
  
  // Close lightbox when clicking outside image
  document.addEventListener('click', function(e) {
    const lightbox = document.getElementById('chapter-lightbox');
    if (lightbox && lightbox.style.display === 'block' && e.target === lightbox) {
      closeChapterLightbox();
    }
  });

  // Chapter navigation with keyboard
  document.addEventListener('keydown', function(e) {
    const lightbox = document.getElementById('chapter-lightbox');
    // Only allow navigation if lightbox is not open
    if (!lightbox || lightbox.style.display !== 'block') {
      <% if @previous_chapter %>
        if (e.key === 'ArrowLeft' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          window.location.href = '<%= chapter_path(@previous_chapter) %>';
        }
      <% end %>
      <% if @next_chapter %>
        if (e.key === 'ArrowRight' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          window.location.href = '<%= chapter_path(@next_chapter) %>';
        }
      <% end %>
    }
  });
</script>
