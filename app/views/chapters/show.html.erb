<section class="chapter max-w-4xl mx-auto px-4">
  <h1 class="text-center mt-6 mb-4"><%= @chapter.title %></h1>
  <% if @chapter.subtitle.present? %>
    <p class="text-center text-gray-600 mb-6"><%= @chapter.subtitle %></p>
  <% end %>

  <% if @chapter.respond_to?(:image_header) && @chapter.image_header.attached? %>
    <div class="chapter-image">
      <%= image_tag url_for(@chapter.image_header), alt: @chapter.title, class: "mx-auto w-full max-w-md h-auto" %>
    </div>
  <% elsif @chapter.respond_to?(:image) && @chapter.image.attached? %>
    <div class="chapter-image">
      <%= image_tag url_for(@chapter.image), alt: @chapter.title, class: "mx-auto w-full max-w-md h-auto" %>
    </div>
  <% end %>

  <div class="chapter-content mx-auto max-w-prose">
    <%= @chapter.content %>
  </div>

  <% if @chapter.audio_file.attached? %>
    <div class="mt-6 mx-auto max-w-prose">
      <details class="border border-gray-200 rounded-lg p-4 bg-gray-50">
        <summary class="cursor-pointer inline-flex items-center px-4 py-2 rounded-md bg-blue-600 text-white font-medium">Open Chapter Audio</summary>
        <div class="mt-4">
          <audio controls preload="none" class="w-full mb-3">
            <source src="<%= url_for(@chapter.audio_file) %>" type="audio/mpeg">
            Your browser does not support the audio element.
          </audio>
          <a href="<%= rails_blob_path(@chapter.audio_file, disposition: "attachment") %>" class="inline-flex items-center px-4 py-2 rounded-md bg-gray-700 text-white">Download Chapter Audio</a>
        </div>
      </details>
    </div>
  <% end %>

  <% if @chapter.title&.include?("32") || @chapter.title&.downcase&.include?("christmas") %>
    <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-blue-800">
        <strong>¹ Alex's messages</strong> 
        <a href="/info/chapter32" target="_blank" class="text-blue-600 hover:text-blue-800 underline ml-2">📖 Read SMS Messages</a>
      </p>
    </div>
  <% end %>

  <% if @chapter.title&.downcase&.include?("strike") || @chapter.title&.match?(/\b13\b/) %>
    <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-blue-800">
        <a href="/info/chapter13" target="_blank" class="text-blue-600 hover:text-blue-800 underline">📖 Read Additional Information</a>
      </p>
    </div>
  <% end %>

  <% if @chapter.title&.downcase&.include?("bali hai") %>
    <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-blue-800">
        <a href="/info/chapter26" target="_blank" class="text-blue-600 hover:text-blue-800 underline">📖 Read Additional Information</a>
      </p>
    </div>
  <% end %>

  <% if @chapter.title&.downcase&.include?("childhood") %>
    <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-blue-800">
        <a href="/info/chapter3" target="_blank" class="text-blue-600 hover:text-blue-800 underline">📖 Read Additional Information</a>
      </p>
    </div>
  <% end %>

  <% if @chapter.title&.downcase&.include?("turning") %>
    <div class="mt-6 p-4 bg-blue-50 border border-blue-200 rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-blue-800">
        <a href="/info/chapter18" target="_blank" class="text-blue-600 hover:text-blue-800 underline">📖 Read Additional Information</a>
      </p>
    </div>
  <% end %>

  <div class="mt-8 flex justify-between">
    <% if @previous_chapter %>
      <%= link_to "← Previous", chapter_path(@previous_chapter), class: "text-blue-600 hover:text-blue-500" %>
    <% else %>
      <span></span>
    <% end %>
    <% if @next_chapter %>
      <%= link_to "Next →", chapter_path(@next_chapter), class: "text-blue-600 hover:text-blue-500" %>
    <% end %>
  </div>
</section>
