<% content_for :title, "#{@chapter.title} | Peter Magner's Autobiography" %>

<% content_for :description, @chapter.subtitle.presence || "Read #{@chapter.title}, a chapter from Peter Magner's autobiography, The Story of an Ordinary Man with an Extraordinary Life." %>

<section class="chapter max-w-4xl mx-auto px-4">
  <h1 class="text-center mt-6 mb-4"><%= @chapter.title %></h1>
  <% if @chapter.subtitle.present? %>
    <p class="text-center text-gray-600 mb-6"><%= @chapter.subtitle %></p>
  <% end %>

  <% if @chapter.audio_file.attached? %>
    <div id="chapter-audio" class="mt-6 mx-auto max-w-prose">
      <div class="border border-gray-200 rounded-lg p-4 bg-brand-bg">
        <div class="text-sm font-semibold text-brand-text mb-3">Chapter Audio</div>
        <audio controls preload="none" class="w-full mb-3">
          <source src="<%= url_for(@chapter.audio_file) %>" type="audio/mpeg">
          Your browser does not support the audio element.
        </audio>
        <a href="<%= rails_blob_path(@chapter.audio_file, disposition: "attachment") %>" class="inline-flex items-center px-4 py-2 rounded-md bg-brand-button hover:bg-brand-hover text-white">Download Chapter Audio</a>
      </div>
    </div>
  <% end %>
  <% if authenticated? %>
  <div class="mt-6 flex flex-wrap justify-center gap-3">

    <%= link_to "← Back to Chapters",
        chapters_path,
        class: "px-4 py-2 rounded-md bg-gray-600 text-white hover:bg-gray-700" %>

    <%= link_to "✏️ Edit Chapter",
        edit_chapter_path(@chapter),
        class: "px-4 py-2 rounded-md bg-blue-600 text-white hover:bg-blue-700" %>

    <%= button_to "🗑 Delete Chapter",
        @chapter,
        method: :delete,
        data: { turbo_confirm: "Delete this chapter?" },
        class: "px-4 py-2 rounded-md bg-red-600 text-white hover:bg-red-700" %>

  </div>
<% end %>

  <% if @chapter.respond_to?(:image_header) && @chapter.image_header.attached? %>
    <div class="chapter-image">
      <%= image_tag url_for(@chapter.image_header), alt: @chapter.title, class: "mx-auto w-full max-w-md h-auto" %>
    </div>
  <% elsif @chapter.respond_to?(:image) && @chapter.image.attached? %>
    <div class="chapter-image">
      <%= image_tag url_for(@chapter.image), alt: @chapter.title, class: "mx-auto w-full max-w-md h-auto" %>
    </div>
  <% end %>

  <div class="chapter-content mx-auto max-w-prose">
    <%= @chapter.content %>
  </div>

  <% if @chapter.title&.include?("32") || @chapter.title&.downcase&.include?("christmas") %>
    <div class="mt-6 p-4 bg-brand-bg border border-brand-accent rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-brand-text">
        <strong>¹ Alex's messages</strong> 
        <a href="/info/chapter32" target="_blank" class="text-brand-accent hover:text-brand-hover underline ml-2">📖 Read SMS Messages</a>
      </p>
    </div>
  <% end %>

  <% if @chapter.title&.downcase&.include?("strike") || @chapter.title&.match?(/\b13\b/) %>
    <div class="mt-6 p-4 bg-brand-bg border border-brand-accent rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-brand-text">
        <a href="/info/chapter13" target="_blank" class="text-brand-accent hover:text-brand-hover underline">📖 Read Additional Information</a>
      </p>
    </div>
  <% end %>

  <% if @chapter.title&.downcase&.include?("bali hai") %>
    <div class="mt-6 p-4 bg-brand-bg border border-brand-accent rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-brand-text">
        <a href="/info/chapter26" target="_blank" class="text-brand-accent hover:text-brand-hover underline">📖 Read Additional Information</a>
      </p>
    </div>
  <% end %>

  <% if @chapter.title&.downcase&.include?("childhood") %>
    <div class="mt-6 p-4 bg-brand-bg border border-brand-accent rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-brand-text">
        <a href="/info/chapter3" target="_blank" class="text-brand-accent hover:text-brand-hover underline">📖 Read Additional Information</a>
      </p>
    </div>
  <% end %>

  <% if @chapter.title&.downcase&.include?("turning") %>
    <div class="mt-6 p-4 bg-brand-bg border border-brand-accent rounded-lg mx-auto max-w-prose">
      <p class="text-sm text-brand-text">
        <a href="/info/chapter18" target="_blank" class="text-brand-accent hover:text-brand-hover underline">📖 Read Additional Information</a>
      </p>
    </div>
  <% end %>

  <div class="mt-8 flex justify-between">
    <% if @previous_chapter %>
      <%= link_to "← Previous", chapter_path(@previous_chapter), class: "text-brand-accent hover:text-brand-hover" %>
    <% else %>
      <span></span>
    <% end %>
    <% if @next_chapter %>
      <%= link_to "Next →", chapter_path(@next_chapter), class: "text-brand-accent hover:text-brand-hover" %>
    <% end %>
  </div>
</section>
