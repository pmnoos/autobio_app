<% content_for :title, "All Chapters" %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-10">
    <h1 class="text-3xl font-bold text-gray-900">All Chapters</h1>
    <p class="text-gray-600 mt-2">Browse through all the chapters of my life story.</p>
  </div>

  <div class="space-y-4">
    <% @chapters.each do |chapter| %>
      <% accent_gradient = if chapter.dedication_chapter?
        "from-rose-500 via-pink-500 to-orange-400"
      elsif chapter.intro_chapter?
        "from-sky-500 via-cyan-500 to-teal-400"
      elsif chapter.epilogue_chapter?
        "from-violet-600 via-indigo-500 to-blue-400"
      elsif chapter.afterword_chapter?
        "from-emerald-500 via-green-500 to-lime-400"
      elsif chapter.about_author_chapter?
        "from-amber-500 via-orange-500 to-red-400"
      else
        "from-slate-700 via-slate-500 to-slate-300"
      end %>

      <div class="group bg-linear-to-br from-white via-slate-50 to-blue-50 rounded-xl shadow-md border border-gray-100 p-6 hover:shadow-lg transition-all">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <% if chapter.dedication_chapter? %>
                <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-3 py-1 rounded-full text-xs font-bold">Dedication</span>
              <% elsif chapter.intro_chapter? %>
                <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-3 py-1 rounded-full text-xs font-bold">Introduction</span>
              <% elsif chapter.epilogue_chapter? %>
                <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-3 py-1 rounded-full text-xs font-bold">Epilogue</span>
              <% elsif chapter.afterword_chapter? %>
                <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-3 py-1 rounded-full text-xs font-bold">Afterword</span>
              <% elsif chapter.about_author_chapter? %>
                <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-3 py-1 rounded-full text-xs font-bold">About the Author</span>
              <% else %>
                <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-3 py-1 rounded-full text-xs font-bold">Chapter <%= chapter.chapter_number %></span>
              <% end %>
            </div>

            <h2 class="text-xl sm:text-2xl font-bold text-gray-900 leading-tight truncate group-hover:text-blue-700 transition-colors">
              <%= link_to chapter.title.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: ""), chapter, class: "hover:text-blue-600 transition-colors" %>
            </h2>

            <% if chapter.subtitle.present? %>
              <p class="text-gray-600 mt-2 truncate"><%= chapter.subtitle.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: "") %></p>
            <% end %>
          </div>

          <div class="flex flex-wrap gap-3 shrink-0">
            <div class="hidden sm:flex items-center justify-center w-14 h-14 rounded-full bg-linear-to-br <%= accent_gradient %> text-white shadow-lg">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
              </svg>
            </div>

            <%= link_to "Read Chapter", chapter_path(chapter), class: "bg-blue-600 hover:bg-blue-500 text-white px-4 py-2 rounded-lg font-medium text-sm transition-colors" %>
            <% if chapter.audio_file.attached? %>
              <%= link_to chapter_path(chapter, anchor: "chapter-audio"), class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg font-medium text-sm transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5 6 9H3v6h3l5 4V5Zm4.5 4.5a4.5 4.5 0 0 1 0 5m2.5-7.5a8 8 0 0 1 0 10" />
                </svg>
                Listen
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
