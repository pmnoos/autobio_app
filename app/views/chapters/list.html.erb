<% content_for :title, "All Chapters" %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <style>
    .chapters-stack.reorder-active .chapter-card {
      cursor: grab;
      outline: 2px dashed #93c5fd;
      outline-offset: 2px;
    }

    .chapters-stack.reorder-active .chapter-card a,
    .chapters-stack.reorder-active .chapter-card form {
      pointer-events: none;
    }

    .sortable-ghost {
      opacity: 0.45;
    }

    .sortable-chosen {
      transform: scale(1.01);
    }
  </style>

  <% if notice.present? %>
    <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-md mb-6">
      <%= notice %>
    </div>
  <% end %>

  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">All Chapters</h1>
      <p class="text-gray-600 mt-2">Browse through all the chapters of my life story</p>
    </div>
    
    <div class="flex space-x-3 items-center">
      <!-- PDF Export Buttons -->
      <% if authenticated? %>
        <%= link_to "📄 Export Complete Book as PDF", export_pdf_chapters_path(format: :pdf), 
            class: "bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg font-medium transition-colors text-sm",
            target: "_blank" %>
      <% end %>
      
      <% if authenticated? %>
        <%= link_to "Add New Chapter", new_chapter_path, 
            class: "bg-blue-600 hover:bg-blue-500 text-white px-6 py-3 rounded-lg font-medium transition-colors" %>
        <button id="chapter-reorder-toggle" type="button" class="bg-amber-500 hover:bg-amber-400 text-white px-6 py-3 rounded-lg font-medium transition-colors">
          Reorder Chapters
        </button>
        <button id="chapter-reorder-save" type="button" class="bg-green-600 hover:bg-green-500 text-white px-6 py-3 rounded-lg font-medium transition-colors" style="display: none;">
          Save Order
        </button>
        <button id="chapter-reorder-cancel" type="button" class="bg-gray-500 hover:bg-gray-400 text-white px-6 py-3 rounded-lg font-medium transition-colors" style="display: none;">
          Cancel
        </button>
      <% end %>
    </div>
  </div>

  <div id="chapters-stack" class="space-y-8 chapters-stack">
    <% if @chapters.any? %>
      <% @chapters.each do |chapter| %>
        <% begin %>
        <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow chapter-card" data-chapter-id="<%= chapter.id %>">
          <div class="flex flex-col lg:flex-row">
            <!-- Chapter Image -->
            <div class="lg:w-1/3">
              <% if chapter.image_header.attached? %>
                <%= image_tag url_for(chapter.image_header), 
                    class: "w-full h-48 object-cover rounded-lg", 
                    alt: chapter.title %>
              <% elsif chapter.respond_to?(:image) && chapter.image.attached? %>
                <%= image_tag url_for(chapter.image), 
                    class: "w-full h-48 object-cover rounded-lg", 
                    alt: chapter.title %>
              <% else %>
                <div class="w-full h-48 bg-linear-to-br from-gray-100 to-gray-200 flex items-center justify-center rounded-lg">
                  <div class="text-center">
                    <svg class="w-16 h-16 text-gray-400 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                    <% if chapter.dedication_chapter? %>
                      <span class="text-gray-500 text-lg font-medium">Dedication</span>
                    <% elsif chapter.intro_chapter? %>
                      <span class="text-gray-500 text-lg font-medium">Introduction</span>
                    <% elsif chapter.epilogue_chapter? %>
                      <span class="text-gray-500 text-lg font-medium">Epilogue</span>
                    <% elsif chapter.afterword_chapter? %>
                      <span class="text-gray-500 text-lg font-medium">Afterword</span>
                    <% elsif chapter.about_author_chapter? %>
                      <span class="text-gray-500 text-lg font-medium">About the Author</span>
                    <% else %>
                      <span class="text-gray-500 text-lg font-medium">Chapter <%= chapter.chapter_number %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
            
            <!-- Chapter Content -->
            <div class="lg:w-2/3 p-8">
              <div class="flex justify-between items-start mb-6">
                <div class="flex-1">
                  <div class="flex items-center gap-3 mb-3">
                    <% if chapter.dedication_chapter? %>
                      <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-4 py-2 rounded-full text-sm font-bold">
                        Dedication
                      </span>
                    <% elsif chapter.intro_chapter? %>
                      <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-4 py-2 rounded-full text-sm font-bold">
                        Introduction
                      </span>
                    <% elsif chapter.epilogue_chapter? %>
                      <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-4 py-2 rounded-full text-sm font-bold">
                        Epilogue
                      </span>
                    <% elsif chapter.afterword_chapter? %>
                      <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-4 py-2 rounded-full text-sm font-bold">
                        Afterword
                      </span>
                    <% elsif chapter.about_author_chapter? %>
                      <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-4 py-2 rounded-full text-sm font-bold">
                        About the Author
                      </span>
                    <% else %>
                      <span class="bg-linear-to-r from-purple-600 to-blue-600 text-white px-4 py-2 rounded-full text-sm font-bold">
                        Chapter <%= chapter.chapter_number %>
                      </span>
                    <% end %>
                  </div>
                  
                  <h2 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-3">
                    <%= link_to chapter.title, chapter, 
                        class: "hover:text-blue-600 transition-colors" %>
                  </h2>
                  
                  <% if chapter.subtitle.present? %>
                    <p class="text-xl text-gray-600 mb-4 leading-relaxed">
                      <%= chapter.subtitle %>
                    </p>
                  <% end %>
                </div>
              </div>
              
              <!-- Content Preview -->
              <div class="text-gray-700 mb-6 leading-relaxed">
                <%= truncate(strip_tags(chapter.content.to_s.encode("UTF-8", invalid: :replace, undef: :replace, replace: "")), length: 300) %>
              </div>
              
              <!-- Action Buttons -->
              <div class="flex flex-wrap gap-3">
                <%= link_to "Read Chapter", chapter, 
                    class: "bg-blue-600 hover:bg-blue-500 text-white px-6 py-2 rounded-lg font-medium transition-colors" %>

                <% if chapter.audio_file.attached? %>
                  <%= link_to "Listen", chapter_path(chapter, anchor: "chapter-audio"),
                      class: "inline-flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white px-6 py-2 rounded-lg font-medium transition-colors" do %>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5 6 9H3v6h3l5 4V5Zm4.5 4.5a4.5 4.5 0 0 1 0 5m2.5-7.5a8 8 0 0 1 0 10" />
                    </svg>
                    Listen
                  <% end %>
                <% end %>
                
                <% if authenticated? %>
                  <%= link_to "📄 Export PDF", export_chapter_pdf_chapter_path(chapter, format: :pdf), 
                      class: "bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-lg font-medium transition-colors text-sm",
                      target: "_blank" %>
                <% end %>
                
                <% if authenticated? %>
                  <%= link_to "Edit", edit_chapter_path(chapter), 
                      class: "bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-2 rounded-lg font-medium transition-colors" %>
                  <%= button_to "Delete", chapter, method: :delete, 
                      class: "bg-red-100 hover:bg-red-200 text-red-700 px-6 py-2 rounded-lg font-medium transition-colors", 
                      data: { turbo_confirm: "Are you sure you want to delete this chapter?" } %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        <% rescue StandardError => e %>
          <% Rails.logger.error("chapters/list render error for chapter_id=#{chapter.id} title=#{chapter.title.inspect}: #{e.class}: #{e.message}") %>
          <div class="bg-amber-50 border border-amber-200 rounded-xl p-6">
            <h3 class="text-amber-900 font-semibold mb-2">A chapter could not be displayed</h3>
            <p class="text-amber-800 text-sm">Chapter ID: <%= chapter.id %>. Please edit this chapter to fix invalid media or content data.</p>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <div class="text-center py-16">
        <div class="mb-8">
          <svg class="mx-auto h-24 w-24 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
        </div>
        <h3 class="text-2xl font-medium text-gray-900 mb-4">No chapters yet</h3>
        <p class="text-gray-600 mb-8">Start writing your life story by creating your first chapter.</p>
        <% if authenticated? %>
          <%= link_to "Write Your First Chapter", new_chapter_path, 
              class: "bg-blue-600 hover:bg-blue-500 text-white px-8 py-3 rounded-lg font-medium transition-colors" %>
        <% else %>
          <%= link_to "Sign In to Add Chapters", new_session_path, 
              class: "bg-blue-600 hover:bg-blue-500 text-white px-8 py-3 rounded-lg font-medium transition-colors" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<% if authenticated? %>
  <script>
    (function() {
      const toggleBtn = document.getElementById('chapter-reorder-toggle');
      const saveBtn = document.getElementById('chapter-reorder-save');
      const cancelBtn = document.getElementById('chapter-reorder-cancel');
      const stack = document.getElementById('chapters-stack');

      if (!toggleBtn || !saveBtn || !cancelBtn || !stack) return;

      let sortable = null;

      function initSortable() {
        if (sortable || !window.Sortable) return;

        sortable = Sortable.create(stack, {
          animation: 150,
          ghostClass: 'sortable-ghost',
          chosenClass: 'sortable-chosen'
        });
      }

      function enterReorderMode() {
        stack.classList.add('reorder-active');
        toggleBtn.style.display = 'none';
        saveBtn.style.display = '';
        cancelBtn.style.display = '';

        if (window.Sortable) {
          initSortable();
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/sortablejs@1.15.3/Sortable.min.js';
        script.onload = initSortable;
        document.head.appendChild(script);
      }

      function exitReorderMode() {
        stack.classList.remove('reorder-active');
        toggleBtn.style.display = '';
        saveBtn.style.display = 'none';
        cancelBtn.style.display = 'none';

        if (sortable) {
          sortable.destroy();
          sortable = null;
        }
      }

      toggleBtn.addEventListener('click', enterReorderMode);
      cancelBtn.addEventListener('click', exitReorderMode);

      saveBtn.addEventListener('click', function() {
        const ids = Array.from(stack.querySelectorAll('[data-chapter-id]')).map(function(el) {
          return el.dataset.chapterId;
        });

        fetch('<%= reorder_chapters_path %>', {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
          },
          body: JSON.stringify({ ids: ids })
        }).then(function(response) {
          if (!response.ok) {
            throw new Error('reorder_failed');
          }

          exitReorderMode();
          const flash = document.createElement('div');
          flash.textContent = 'Chapter order saved.';
          flash.className = 'fixed bottom-6 right-6 bg-green-600 text-white px-5 py-3 rounded-xl shadow-lg z-50 text-sm font-medium';
          document.body.appendChild(flash);
          setTimeout(function() { flash.remove(); }, 2500);
        }).catch(function() {
          alert('Failed to save chapter order. Please try again.');
        });
      });
    })();
  </script>
<% end %>
