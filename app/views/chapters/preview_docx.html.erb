<h1 class="text-3xl font-bold text-gray-900 mb-4">DOCX Import Preview</h1>

<p class="text-gray-700 mb-6">
  Compare each DOCX chapter with the suggested website chapter, then choose exactly where each chapter should be imported.
</p>

<%= form_with url: import_docx_apply_chapters_path,
              method: :post,
              local: true,
              data: { turbo: false } do |form| %>
  <%= hidden_field_tag :import_token, @import_token %>

  <div class="overflow-x-auto mb-6">
    <table class="min-w-full divide-y divide-gray-200 border border-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">DOCX position</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">DOCX chapter</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">DOCX content</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Suggested website chapter</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Website content (suggested)</th>
          <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Status</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-100">
        <% @preview.each do |row| %>
          <tr>
            <td class="px-4 py-3 text-sm text-gray-900 align-top"><%= row[:position] %></td>
            <td class="px-4 py-3 text-sm text-gray-700 align-top"><%= row[:word_chapter_title].presence || "-" %></td>
            <td class="px-4 py-3 text-sm text-gray-700 max-w-md align-top"><%= row[:word_content_excerpt].presence || "-" %></td>
            <td class="px-4 py-3 text-sm text-gray-700 align-top min-w-80">
              <%= hidden_field_tag "mappings[#{row[:imported_index]}][imported_index]", row[:imported_index] %>
              <%= select_tag "mappings[#{row[:imported_index]}][chapter_id]",
                             options_for_select(
                               [["Skip this DOCX chapter", ""]] + @website_chapters.map { |chapter| ["#{chapter.id}: #{chapter.title}", chapter.id] },
                               row[:suggested_chapter_id]
                             ),
                             class: "block w-full border border-gray-300 rounded-md px-3 py-2" %>

              <% if row[:suggested_chapter_id].present? %>
                <div class="mt-2">
                  <%= link_to "Edit suggested website chapter",
                              edit_chapter_path(row[:suggested_chapter_id]),
                              class: "inline-flex items-center px-3 py-2 rounded border border-blue-300 text-blue-700 hover:bg-blue-50" %>
                </div>
              <% end %>
            </td>
            <td class="px-4 py-3 text-sm text-gray-700 max-w-md align-top"><%= row[:website_content_excerpt].presence || "-" %></td>
            <td class="px-4 py-3 text-sm font-medium text-gray-900 align-top"><%= row[:match_status] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit "Import Using Selected Mapping",
                    class: "inline-flex items-center px-6 py-3 rounded-md text-white bg-green-600 hover:bg-green-700 font-semibold" %>

    <%= link_to "Back", import_docx_chapters_path,
                class: "inline-flex items-center px-5 py-3 rounded-md border border-gray-300 text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>