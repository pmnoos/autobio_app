<% unless admin? %>
  <div class="mt-8 pt-6 border-t border-brand-accent/30">
    <h2 class="text-xl font-semibold mb-1">Suggest a change</h2>
    <p class="text-sm text-brand-text/60 mb-3">
      Know something about <%= person.first_name %>, or spotted a mistake? Send Peter a note and he will update the page.
    </p>

    <%= form_with url: suggestions_path, method: :post, class: "space-y-3" do |f| %>
      <%= hidden_field_tag :person_id, person.id %>

      <%# Bots fill this in. People never see it. %>
      <div style="position:absolute; left:-9999px;" aria-hidden="true">
        <%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %>
      </div>

      <div>
        <%= label_tag :name, "Your name", class: "block text-sm font-medium mb-1" %>
        <%= text_field_tag :name, nil, maxlength: 100, class: "w-full rounded-md border border-brand-accent/40 px-3 py-2" %>
      </div>

      <div>
        <%= label_tag :email, "Your email (optional, so Peter can reply)", class: "block text-sm font-medium mb-1" %>
        <%= email_field_tag :email, nil, maxlength: 150, class: "w-full rounded-md border border-brand-accent/40 px-3 py-2" %>
      </div>

      <div>
        <%= label_tag :message, "Your note", class: "block text-sm font-medium mb-1" %>
        <%= text_area_tag :message, nil, rows: 4, maxlength: 2000, required: true, class: "w-full rounded-md border border-brand-accent/40 px-3 py-2" %>
      </div>

      <%= submit_tag "Send note", class: "px-5 py-2 rounded-md font-semibold bg-brand-button text-white hover:bg-brand-hover" %>
    <% end %>
  </div>
<% end %>
