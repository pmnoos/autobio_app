<div class="max-w-3xl mx-auto p-4 bg-brand-bg text-brand-text">
  <div class="text-center mb-8 pb-6 border-b border-brand-accent/30">
    <% if @person.is_self? %>
      <span class="inline-block bg-brand-accent text-white text-xs font-semibold px-3 py-1 rounded-full mb-2">This is you</span>
    <% end %>
    <% if authenticated? && @person.private_profile? %>
    <span class="inline-block bg-gray-600 text-white text-xs font-semibold px-3 py-1 rounded-full mb-2">
      🔒 Private
    </span>
<% end %>
 <% if @person.private_profile? && !authenticated? %>

  <h1 class="text-4xl font-bold"><%= @person.full_name %></h1>

  <p class="mt-3 text-base text-brand-text/60">
    Living family member — some details are private.
  </p>

<% else %>

  <% if @person.photo.attached? %>
    <%= image_tag @person.photo,
          class: "w-40 h-40 rounded-full object-cover mx-auto mb-4 border-4 border-brand-accent" %>
  <% end %>

  <h1 class="text-4xl font-bold"><%= @person.full_name %></h1>

  <p class="mt-2 text-lg font-medium text-brand-text">
    <%= @person.birth_date&.strftime("%Y") %>
    <% if @person.death_date %>
      – <%= @person.death_date.strftime("%Y") %>
    <% end %>
  </p>

  <% if @person.birth_place.present? %>
    <p class="mt-1 text-sm text-brand-text/60">
      Born in
      <span class="text-base font-medium text-brand-text">
        <%= @person.birth_place %>
      </span>
    </p>
  <% end %>

  <% if @person.bio_notes.present? %>
    <p class="mt-4 text-base leading-relaxed">
      <%= @person.bio_notes %>
    </p>
  <% end %>

<% end %>

    <% if authenticated? %>
      <div class="mt-4 flex justify-center gap-3">
        <%= link_to "Edit", edit_person_path(@person), class: "px-5 py-2 rounded-md font-semibold bg-brand-button text-white hover:bg-brand-hover" %>
        <%= button_to "Remove", person_path(@person), method: :delete,
              data: { turbo_confirm: "Remove #{@person.full_name}?" },
              class: "px-5 py-2 rounded-md font-semibold border border-brand-text/30 text-brand-text hover:bg-brand-text/5" %>
      </div>
    <% end %>
  </div>

  <div class="flex justify-center gap-4 text-sm mb-6 pb-4 border-b border-brand-accent/20">
    <% if (me = Person.me) && me != @person %>
      <%= link_to "🏠 Home (You)", person_path(me), class: "text-brand-button hover:underline" %>
    <% end %>

    <% if authenticated? %>
      <%= link_to "+ Add family member here", new_person_path(related_to: @person.id), class: "text-brand-button hover:underline" %>
    <% end %>

    <%= link_to "← Back", :back, class: "text-brand-button hover:underline" %>
  </div>

  <% show_relatives = authenticated? || !@person.private_profile? %>

  <% if show_relatives %>
  <div class="mb-6">
    <h2 class="text-xl font-semibold border-b border-brand-accent/30 pb-1 mb-2">
      Spouse<%= "s" if @person.spouse_relationships.size > 1 %>
    </h2>
    <ul class="divide-y divide-brand-accent/10">
      <% @person.spouse_relationships.each do |rel| %>
        <li class="py-2 flex justify-between items-center">
          <div>
            <%= link_to rel[:person].full_name, person_path(rel[:person]), class: "text-brand-button font-medium hover:underline" %>
            <% if rel[:start_date] || rel[:end_date] %>
              <span class="text-sm text-brand-text/60">
                (<%= rel[:start_date]&.strftime("%Y") || "?" %>–<%= rel[:end_date]&.strftime("%Y") || "present" %>)
              </span>
            <% end %>
          </div>
          <% if authenticated? %>
            <%= link_to "Edit", edit_person_path(rel[:person]), class: "text-sm text-brand-accent hover:underline" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <% [["Parents", @parents], ["Children", @children], ["Siblings", @siblings]].each do |label, list| %>
    <div class="mb-6">
      <h2 class="text-xl font-semibold border-b border-brand-accent/30 pb-1 mb-2"><%= label %></h2>
      <ul class="divide-y divide-brand-accent/10">
        <% list.each do |person| %>
          <li class="py-2 flex justify-between items-center">
            <%= link_to person.full_name, person_path(person), class: "text-brand-button font-medium hover:underline" %>
            <% if authenticated? %>
              <%= link_to "Edit", edit_person_path(person), class: "text-sm text-brand-accent hover:underline" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <% end %>

  <%= render 'people/suggestion_form', person: @person %>
  <% if authenticated? %>
    <%= link_to "Add a family member", new_person_path(related_to: @person.id), class: "inline-block px-5 py-2 rounded-md font-semibold bg-brand-button text-white hover:bg-brand-hover" %>
  <% end %>

  <% if authenticated? %>
    <div class="mt-8 pt-6 border-t border-brand-accent/30">
      <h2 class="text-sm font-medium uppercase tracking-wide text-brand-text/60 mb-2">Research this person</h2>
      <p class="text-sm text-brand-text/60 mb-3">Search free genealogy sites for records matching this person:</p>
      <ul class="flex flex-wrap gap-3">
        <% @person.research_links.each do |site, url| %>
          <li>
            <%= link_to site, url, target: "_blank", rel: "noopener",
                  class: "inline-block px-3 py-1.5 text-sm rounded-md border border-brand-accent/40 text-brand-button hover:bg-brand-accent/10" %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>