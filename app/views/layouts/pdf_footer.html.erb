<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <style>
      body {
        font-family: 'Georgia', 'Times New Roman', serif;
        font-size: 12pt;
        line-height: 1.6;
        color: #333;
        margin: 0;
        padding: 0;
      }
      
      .pdf-container {
        max-width: 100%;
        margin: 0;
        padding: 20px;
      }
      
      h1 {
        font-size: 24pt;
        margin-bottom: 20px;
        color: #2d3748;
        text-align: center;
        border-bottom: 3px solid #667eea;
        padding-bottom: 10px;
      }
      
      h2 {
        font-size: 18pt;
        margin-top: 30px;
        margin-bottom: 15px;
        color: #2d3748;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 5px;
      }
      
      h3 {
        font-size: 14pt;
        margin-top: 20px;
        margin-bottom: 10px;
        color: #4a5568;
      }
      
      p {
        margin-bottom: 12px;
        text-align: justify;
      }
      
      .chapter {
        page-break-before: always;
        margin-bottom: 40px;
      }
      
      .chapter:first-child {
        page-break-before: auto;
      }
      
      .chapter-header {
        text-align: center;
        margin-bottom: 30px;
        padding: 20px 0;
        border-bottom: 2px solid #667eea;
      }
      
      .chapter-number {
        font-size: 14pt;
        color: #667eea;
        font-weight: bold;
        margin-bottom: 5px;
      }
      
      .chapter-title {
        font-size: 20pt;
        color: #2d3748;
        margin: 10px 0;
        font-weight: bold;
      }
      
      .chapter-subtitle {
        font-size: 14pt;
        color: #718096;
        font-style: italic;
        margin-top: 5px;
      }
      
      .chapter-content {
        text-align: justify;
        line-height: 1.7;
      }
      
      .chapter-date {
        font-size: 10pt;
        color: #a0aec0;
        text-align: center;
        margin-top: 10px;
      }
      
      .cover-page {
        text-align: center;
        padding: 100px 20px;
        page-break-after: always;
      }
      
      .cover-title {
        font-size: 32pt;
        font-weight: bold;
        color: #2d3748;
        margin-bottom: 20px;
        line-height: 1.2;
      }
      
      .cover-subtitle {
        font-size: 18pt;
        color: #667eea;
        margin-bottom: 40px;
        font-style: italic;
      }
      
      .cover-author {
        font-size: 16pt;
        color: #4a5568;
        margin-bottom: 60px;
      }
      
      .cover-date {
        font-size: 12pt;
        color: #a0aec0;
      }
      
      .table-of-contents {
        page-break-after: always;
        margin-bottom: 40px;
      }
      
      .toc-title {
        font-size: 20pt;
        text-align: center;
        margin-bottom: 30px;
        color: #2d3748;
        border-bottom: 2px solid #667eea;
        padding-bottom: 10px;
      }
      
      .toc-entry {
        margin-bottom: 8px;
        display: flex;
        justify-content: space-between;
        border-bottom: 1px dotted #e2e8f0;
        padding-bottom: 5px;
      }
      
      .toc-chapter {
        font-weight: bold;
      }
      
      .toc-page {
        color: #718096;
      }
      
      /* Print-specific styles */
      @media print {
        .chapter {
          page-break-before: always;
        }
        
        .cover-page, .table-of-contents {
          page-break-after: always;
        }
      }
      
      /* Image styles */
      img {
        max-width: 100%;
        height: auto;
        margin: 20px 0;
        display: block;
        margin-left: auto;
        margin-right: auto;
      }
      
      /* Rich text content styles */
      .chapter-content ul, .chapter-content ol {
        margin: 15px 0;
        padding-left: 30px;
      }
      
      .chapter-content li {
        margin-bottom: 5px;
      }
      
      .chapter-content blockquote {
        margin: 20px 30px;
        padding: 15px 20px;
        background-color: #f7fafc;
        border-left: 4px solid #667eea;
        font-style: italic;
      }
      
      .chapter-content strong {
        font-weight: bold;
        color: #2d3748;
      }
      
      .chapter-content em {
        font-style: italic;
      }
    </style>
  </head>
  <body>
    <div class="pdf-container">
      <%= yield %>
    </div>
  </body>
</html>
