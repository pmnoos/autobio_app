<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Peter Magner | The Story of an Ordinary Man with an Extraordinary Life" %></title>

    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "The autobiography of Peter Magner — stories, memories and life's journey. The story of an ordinary man with an extraordinary life." %>">

    <meta name="keywords" content="Peter Magner, autobiography, memoir, life story, stories, memories, extraordinary life">

    <meta name="author" content="Peter Magner">

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <!-- Open Graph / Social Sharing -->
    <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "Peter Magner | My Autobiography" %>">

    <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : "Stories, memories and life's journey — The Story of an Ordinary Man with an Extraordinary Life." %>">

    <meta property="og:type" content="website">

    <meta property="og:url" content="<%= request.original_url %>">

    <meta property="og:site_name" content="Peter Magner | My Autobiography">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "actiontext", "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>

  </head>

  <body class="bg-brand-bg">
  
 
    <!-- Navigation Bar -->
    <nav class="bg-white shadow-lg fixed top-0 left-0 right-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <!-- Logo/Brand -->
          <div class="flex items-center space-x-4">
            <%# Profile photo: goes home when signed in, goes to sign-in when signed out.
                This is a deliberately low-visibility way for the site owner to reach
                sign-in without a public "Sign In" button on the page. %>
            <%= link_to (authenticated? ? root_path : new_session_path) do %>
              <div class="w-10 h-10 rounded-full overflow-hidden bg-linear-to-br from-brand-accent to-brand-button flex items-center justify-center">
                <img src="/profile.jpg" 
                     alt="Profile Photo" 
                     class="w-full h-full object-cover"
                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <!-- Fallback icon if image fails to load -->
                <svg class="w-6 h-6 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
            <% end %>
            <%= link_to "My Autobiography", root_path, class: "text-xl font-bold text-brand-text" %>
          </div>

          <!-- Navigation Links -->
          <div class="hidden md:flex items-center space-x-8">
            <%= link_to "Home", root_path, class: "text-brand-text hover:text-brand-accent px-3 py-2 text-sm font-medium transition-colors" %>
            <%= link_to "Chapters", list_chapters_path, class: "text-brand-text hover:text-brand-accent px-3 py-2 text-sm font-medium transition-colors" %>
            <%= link_to "Gallery", photos_path, class: "text-brand-text hover:text-brand-accent px-3 py-2 text-sm font-medium transition-colors" %>
            
            <!-- Authentication Links -->
            <% if authenticated? %>
              <div class="flex items-center space-x-4">
                <span class="text-gray-600 text-sm">Welcome, <%= Current.session.user.email_address %></span>
                <%= button_to "Sign Out", session_path, method: :delete, 
                    class: "bg-red-600 hover:bg-red-500 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors" %>
              </div>
            <% end %>
          </div>

          <!-- Mobile menu button -->
          <div class="md:hidden flex items-center">
            <button id="mobile-menu-button" class="text-brand-text hover:text-brand-accent focus:outline-none">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="md:hidden hidden bg-white border-t border-gray-200">
        <div class="px-2 pt-2 pb-3 space-y-1">
          <%= link_to "Home", root_path, class: "block px-3 py-2 text-brand-text hover:text-brand-accent text-base font-medium" %>
          <%= link_to "Chapters", list_chapters_path, class: "block px-3 py-2 text-brand-text hover:text-brand-accent text-base font-medium" %>
          <%= link_to "Gallery", photos_path, class: "block px-3 py-2 text-brand-text hover:text-brand-accent text-base font-medium" %>
          
          <% if authenticated? %>
            <div class="border-t border-gray-200 pt-2">
              <span class="block px-3 py-2 text-gray-600 text-sm">Welcome, <%= Current.session.user.email_address %></span>
              <%= button_to "Sign Out", session_path, method: :delete, 
                  class: "w-full text-left px-3 py-2 text-red-600 hover:text-red-500 text-base font-medium" %>
            </div>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="pt-16">
        <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-white shadow-lg mt-16 border-t border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Profile and About Section - Centered -->
        <div class="text-center mb-8">
          <div class="flex justify-center items-center space-x-4 mb-4">
            <div class="w-10 h-10 rounded-full overflow-hidden bg-linear-to-br from-brand-accent to-brand-button flex items-center justify-center">
              <img src="/profile.jpg" 
                   alt="Profile Photo" 
                   class="w-full h-full object-cover"
                   onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
              <svg class="w-6 h-6 text-white hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            <span class="text-xl font-semibold text-brand-text">My Life Story</span>
          </div>
          <p class="text-gray-600 max-w-2xl mx-auto">
            A personal journey through life's chapters, memories, and moments that shaped who I am today. 
            This digital autobiography preserves stories and photographs for future generations.
          </p>
        </div>

        <!-- Links Section - All on one line -->
        <div class="text-center mb-8">
          <div class="flex flex-wrap justify-center items-center gap-6 text-brand-text">
            <%= link_to "Home", root_path, class: "hover:text-brand-accent transition-colors font-medium" %>
            <span class="text-gray-300">•</span>
            <%= link_to "All Chapters", list_chapters_path, class: "hover:text-brand-accent transition-colors font-medium" %>
            <span class="text-gray-300">•</span>
            <%= link_to "Photo Gallery", photos_path, class: "hover:text-brand-accent transition-colors font-medium" %>
            <span class="text-gray-300">•</span>
            <%= link_to "About", "/about", class: "hover:text-brand-accent transition-colors font-medium" %>
            <span class="text-gray-300">•</span>
            <%= link_to "Privacy Notice", "/privacy", class: "hover:text-brand-accent transition-colors font-medium" %>
            <span class="text-gray-300">•</span>
            <%= link_to "Terms of Use", "/terms", class: "hover:text-brand-accent transition-colors font-medium" %>
            <span class="text-gray-300">•</span>
            <%= link_to "Contact", "/contact", class: "hover:text-brand-accent transition-colors font-medium" %>
            <% if authenticated? %>
              <span class="text-gray-300">•</span>
              <%= link_to "New Chapter", new_chapter_path, class: "hover:text-brand-accent transition-colors font-medium" %>
              <span class="text-gray-300">•</span>
              <%= link_to "Add Photo", new_photo_path, class: "hover:text-brand-accent transition-colors font-medium" %>
            <% end %>
          </div>
        </div>

        <!-- Bottom Bar -->
        <div class="border-t border-gray-200 pt-8 flex flex-col md:flex-row justify-between items-center text-center md:text-left">
          <div class="text-brand-text text-sm">
            © <%= Date.current.year %> My Autobiography. All rights reserved.
          </div>
          <div class="text-gray-500 text-sm mt-2 md:mt-0">
            Last updated: <%= Date.current.strftime("%B %Y") %>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script (Turbo-safe) -->
    <script>
      window.addEventListener('turbo:load', function() {
        const button = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        if (!button || !mobileMenu) return;
        // Avoid stacking multiple listeners across Turbo visits
        if (!button.dataset.bound) {
          button.addEventListener('click', function() {
            mobileMenu.classList.toggle('hidden');
          });
          button.dataset.bound = 'true';
        }
      });
    </script>
    <!-- Removed incorrect dynamic import for narration.js -->
    <script>
      window.addEventListener('turbo:load', function() {
        const button = document.getElementById('mobile-menu-button');
        const mobileMenu = document.getElementById('mobile-menu');
        if (!button || !mobileMenu) return;
        // Avoid stacking multiple listeners across Turbo visits
        if (!button.dataset.bound) {
          button.addEventListener('click', function() {
            mobileMenu.classList.toggle('hidden');
          });
          button.dataset.bound = 'true';
        }
      });
    </script>
