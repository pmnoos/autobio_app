<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? yield(:title) : "Autobiography PDF" %></title>
    <style>
      /* Basic, print-friendly defaults */
      body { font-family: Georgia, serif; color: #333; line-height: 1.5; font-size: 12pt; }
      h1, h2, h3 { margin: 0.6em 0 0.3em; }
      h1 { font-size: 24pt; }
      h2 { font-size: 18pt; }
      h3 { font-size: 14pt; }
      p { margin: 0 0 0.8em; }
      .page-break { page-break-after: always; }
    </style>
    <%= csrf_meta_tags %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
