<% content_for(:title, "Contact - My Autobiography") %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-brand-text mb-4">Contact</h1>
    <p class="text-xl text-gray-600 max-w-2xl mx-auto">
      Get in touch with questions, comments, or to share your own memories.
    </p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Contact Information -->
    <div class="bg-white rounded-lg shadow-md p-8">
      <h2 class="text-2xl font-bold text-brand-text mb-6">Get in Touch</h2>
      
      <div class="space-y-6">
        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <svg class="w-6 h-6 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-brand-text">Email</h3>
            <p class="text-gray-600">contact@myautobiography.com</p>
            <p class="text-sm text-gray-500 mt-1">
              For questions about the website or to share memories
            </p>
          </div>
        </div>

        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <svg class="w-6 h-6 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-brand-text">Location</h3>
            <p class="text-gray-600">Available worldwide</p>
            <p class="text-sm text-gray-500 mt-1">
              This digital autobiography can be accessed from anywhere
            </p>
          </div>
        </div>

        <div class="flex items-start space-x-4">
          <div class="flex-shrink-0">
            <svg class="w-6 h-6 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-semibold text-brand-text">Response Time</h3>
            <p class="text-gray-600">Usually within 24-48 hours</p>
            <p class="text-sm text-gray-500 mt-1">
              We'll get back to you as soon as possible
            </p>
          </div>
        </div>
      </div>

      <div class="mt-8 border-t border-gray-200 pt-8">
        <h3 class="text-lg font-semibold text-brand-text mb-4">About This Website</h3>
        <p class="text-gray-600 text-sm">
          This autobiography website was created to preserve and share life's most important moments. 
          It serves as a digital legacy for family and friends to understand the experiences and 
          memories that shaped a lifetime.
        </p>
      </div>
    </div>

    <!-- Contact Form -->
    <%= render "shared/contact_form" %>
  </div>

  <!-- Additional Information -->
  <div class="mt-12 bg-brand-bg rounded-lg p-8 text-center">
    <h3 class="text-xl font-semibold text-brand-text mb-4">Family & Friends</h3>
    <p class="text-gray-600 mb-6">
      If you're family or a close friend and have photos, stories, or memories you'd like to contribute 
      to this autobiography, please reach out. Your perspective and memories are invaluable in creating 
      a complete picture of this life story.
    </p>
    <div class="space-x-4">
      <%= link_to "View Chapters", list_chapters_path, 
          class: "bg-brand-button hover:bg-brand-hover text-white px-6 py-3 rounded-md font-medium transition-colors" %>
      <%= link_to "Browse Gallery", photos_path, 
          class: "border-2 border-brand-accent text-brand-accent hover:bg-brand-accent hover:text-white px-6 py-3 rounded-md font-medium transition-colors" %>
    </div>
  </div>
</div>